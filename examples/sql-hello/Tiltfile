def sql_hello(namespace, resource_deps=[]):
    workspace_deps = [
        'examples/sql-hello/Cargo.toml',
        'examples/sql-hello/Cargo.lock',
        'examples/sql-hello/setup/Cargo.toml',
        'examples/sql-hello/query/Cargo.toml',
        'examples/sql-hello/insert-test/Cargo.toml',
        'framework/runtime.wit',
    ]

    custom_build(
        'sql-hello-migrations',
        command = (
            'mkdir -p examples/sql-hello/bin &&' +
            'tar czf examples/sql-hello/bin/sql-hello-migrations.tar.gz -C examples/sql-hello/migrations . &&' +
            ' oras push $EXPECTED_REF' +
            ' examples/sql-hello/bin/sql-hello-migrations.tar.gz:application/vnd.db-operator.migrations.v1.tar+gzip' +
            ' --artifact-type application/vnd.db-operator.migrations.v1.tar+gzip' +
            ' --plain-http'
        ),
        deps = [
            'examples/sql-hello/migrations/',
        ],
        skips_local_docker = True,
    )

    custom_build(
        'sql-hello-setup',
        command = (
            'cargo build --locked --manifest-path examples/sql-hello/setup/Cargo.toml' +
            ' --target wasm32-wasip2 --release --target-dir target &&' +
            ' oras push $EXPECTED_REF' +
            ' target/wasm32-wasip2/release/setup.wasm' +
            ' --artifact-type application/vnd.wasm.content.layer.v1+wasm' +
            ' --plain-http'
        ),
        deps = workspace_deps + ['examples/sql-hello/setup'],
        skips_local_docker = True,
    )

    custom_build(
        'sql-hello-query',
        command = (
            'cargo build --locked --manifest-path examples/sql-hello/query/Cargo.toml' +
            ' --target wasm32-wasip2 --release --target-dir target &&' +
            ' oras push $EXPECTED_REF' +
            ' target/wasm32-wasip2/release/query.wasm' +
            ' --artifact-type application/vnd.wasm.content.layer.v1+wasm' +
            ' --plain-http'
        ),
        deps = workspace_deps + ['examples/sql-hello/query'],
        skips_local_docker = True,
    )

    custom_build(
        'sql-hello-insert-test',
        command = (
            'cargo build --locked --manifest-path examples/sql-hello/insert-test/Cargo.toml' +
            ' --target wasm32-wasip2 --release --target-dir target &&' +
            ' oras push $EXPECTED_REF' +
            ' target/wasm32-wasip2/release/insert_test.wasm' +
            ' --artifact-type application/vnd.wasm.content.layer.v1+wasm' +
            ' --plain-http'
        ),
        deps = workspace_deps + ['examples/sql-hello/insert-test'],
        skips_local_docker = True,
    )

    k8s_yaml('examples/sql-hello/application.yaml')

    k8s_resource(
        'sql-hello',
        resource_deps = ['module-cache', 'wp-operator'] + resource_deps,
        labels = ['example'],
    )
