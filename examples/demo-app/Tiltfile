def demo_app(namespace, resource_deps=[]):
    workspace_deps = [
        'examples/demo-app/Cargo.toml',
        'examples/demo-app/Cargo.lock',
        'examples/demo-app/http-handler/Cargo.toml',
        'examples/demo-app/message-handler/Cargo.toml',
        'framework/runtime.wit',
    ]

    custom_build(
        'demo-app-http',
        command = (
            'cargo build --locked --manifest-path examples/demo-app/http-handler/Cargo.toml' +
            ' --target wasm32-wasip2 --release --target-dir target &&' +
            ' oras push $EXPECTED_REF' +
            ' target/wasm32-wasip2/release/http_handler.wasm' +
            ' --artifact-type application/vnd.wasm.content.layer.v1+wasm' +
            ' --plain-http'
        ),
        deps = workspace_deps + ['examples/demo-app/http-handler'],
        skips_local_docker = True,
    )

    custom_build(
        'demo-app-messages',
        command = (
            'cargo build --locked --manifest-path examples/demo-app/message-handler/Cargo.toml' +
            ' --target wasm32-wasip2 --release --target-dir target &&' +
            ' oras push $EXPECTED_REF' +
            ' target/wasm32-wasip2/release/message_handler.wasm' +
            ' --artifact-type application/vnd.wasm.content.layer.v1+wasm' +
            ' --plain-http'
        ),
        deps = workspace_deps + ['examples/demo-app/message-handler'],
        skips_local_docker = True,
    )

    k8s_yaml('examples/demo-app/application.yaml')

    k8s_resource(
        'demo-app',
        resource_deps = ['module-cache', 'wp-operator'] + resource_deps,
        labels = ['example'],
    )
