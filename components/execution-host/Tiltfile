load('../../tilt/ci.Tiltfile', 'CI_MODE')
load('../../tilt/workspace-deps.Tiltfile', 'RUST_WORKSPACE_INPUTS')

IMAGE_REF = 'wasm-platform-registry.localhost:5001/execution-host'

def execution_host(resource_deps=[]):
    source_deps = RUST_WORKSPACE_INPUTS + [
        'components/execution-host/src',
        'components/execution-host/Cargo.toml',
        'components/execution-host/build.rs',
        'proto/configsync/v1/configsync.proto',
        'framework/runtime.wit',
    ]

    custom_build(
        IMAGE_REF,
        command = (
            'docker build' +
            ' --build-context workspace=.' +
            ' --build-arg WORKSPACE_DEPS_IMAGE=$TILT_IMAGE_0' +
            ' -f components/execution-host/Dockerfile' +
            ' -t $EXPECTED_REF' +
            ' components/execution-host'
        ),
        deps = source_deps + [
            'components/execution-host/Dockerfile',
            '.dockerignore',
        ],
        image_deps = ['workspace-deps'],
    )

    local_resource(
        'execution-host: format',
        cmd = 'cargo fmt --all',
        labels = ['execution-host'],
        auto_init = False,
        trigger_mode = TRIGGER_MODE_MANUAL,
    )

    local_resource(
        'execution-host: update-dependencies',
        cmd = 'cargo check -p execution-host',
        labels = ['execution-host'],
        auto_init = False,
        trigger_mode = TRIGGER_MODE_MANUAL,
    )

    local_resource(
        'execution-host: regression-tests',
        allow_parallel = True,
        cmd = 'cargo test --locked -p platform-common -p execution-host',
        deps = source_deps,
        resource_deps = ['ci: record-revision'] if CI_MODE else [],
        labels = ['execution-host'],
    )

    local_resource(
        'execution-host: lint',
        allow_parallel = True,
        cmd = 'cargo clippy --locked -p platform-common -p execution-host --all-targets -- -D warnings',
        deps = source_deps,
        resource_deps = ['ci: record-revision'] if CI_MODE else [],
        labels = ['execution-host'],
        auto_init = CI_MODE,
        trigger_mode = TRIGGER_MODE_AUTO if CI_MODE else TRIGGER_MODE_MANUAL,
    )

    k8s_resource(
        'execution-host',
        labels = ['platform'],
        port_forwards = ['3001:3000', '9090:9090'],
        resource_deps = resource_deps,
    )

    k8s_yaml('components/execution-host/tests/redis-cancellation.yaml')
    k8s_resource(
        'redis-cancellation',
        port_forwards = ['6391:6379'],
        labels = ['execution-host'],
    )
    local_resource(
        'execution-host: redis-cancellation-tests',
        cmd = 'REDIS_TEST_URL=redis://localhost:6391 cargo test --locked -p execution-host redis_client::tests::queued_mutations -- --ignored',
        deps = source_deps + ['components/execution-host/tests/redis-cancellation.yaml'],
        resource_deps = ['redis-cancellation'] + (['ci: record-revision'] if CI_MODE else []),
        trigger_mode = TRIGGER_MODE_AUTO if CI_MODE else TRIGGER_MODE_MANUAL,
        auto_init = CI_MODE,
        labels = ['execution-host'],
    )
