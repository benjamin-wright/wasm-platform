IMAGE_REF = 'wasm-platform-registry.localhost:5001/execution-host'

def execution_host(resource_deps=[]):
    custom_build(
        IMAGE_REF,
        command = (
            'docker build' +
            ' --build-context workspace=.' +
            ' --build-arg WORKSPACE_DEPS_IMAGE=$TILT_IMAGE_0' +
            ' -f components/execution-host/Dockerfile' +
            ' -t $EXPECTED_REF' +
            ' components/execution-host'
        ),
        deps = [
            'components/execution-host/src',
            'components/execution-host/Cargo.toml',
            'components/execution-host/Dockerfile',
            'components/execution-host/build.rs',
            'lib/platform-common',
            'proto/configsync/v1/configsync.proto',
            'framework/runtime.wit',
            '.dockerignore',
        ],
        image_deps = ['workspace-deps'],
    )

    regression_deps = [
        'Cargo.toml',
        'Cargo.lock',
        'components/execution-host/src',
        'components/execution-host/Cargo.toml',
        'components/execution-host/build.rs',
        'components/execution-host/Tiltfile',
        'components/gateway/src',
        'components/gateway/Cargo.toml',
        'components/gateway/build.rs',
        'components/gateway/Tiltfile',
        'lib/platform-common',
        'proto/configsync/v1/configsync.proto',
        'proto/gateway/v1/gateway.proto',
        'framework/runtime.wit',
    ]

    local_resource(
        'execution-host: regression-tests',
        cmd = 'cargo test --locked -p platform-common -p execution-host -p gateway',
        deps = regression_deps,
        labels = ['execution-host'],
    )

    local_resource(
        'execution-host: lint',
        cmd = 'cargo clippy --locked -p platform-common -p execution-host -p gateway -p module-cache --all-targets',
        deps = regression_deps + [
            'components/module-cache/src',
            'components/module-cache/Cargo.toml',
            'components/module-cache/Tiltfile',
        ],
        labels = ['execution-host'],
        auto_init = False,
        trigger_mode = TRIGGER_MODE_MANUAL,
    )

    k8s_resource(
        'execution-host',
        labels = ['platform'],
        port_forwards = ['3001:3000', '9090:9090'],
        resource_deps = resource_deps,
    )

    k8s_yaml('components/execution-host/tests/redis-cancellation.yaml')
    k8s_resource(
        'redis-cancellation',
        port_forwards = ['6391:6379'],
        labels = ['execution-host'],
    )
    local_resource(
        'execution-host: redis-cancellation-tests',
        cmd = 'REDIS_TEST_URL=redis://localhost:6391 cargo test --locked -p execution-host redis_client::tests::queued_mutations -- --ignored',
        deps = ['components/execution-host/src', 'components/execution-host/tests/redis-cancellation.yaml', 'components/execution-host/Cargo.toml', 'Cargo.lock'],
        resource_deps = ['redis-cancellation'],
        trigger_mode = TRIGGER_MODE_MANUAL,
        auto_init = False,
        labels = ['execution-host'],
    )
