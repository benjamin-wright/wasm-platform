load('../../tilt/ci.Tiltfile', 'CI_MODE')

IMAGE_REF = 'wasm-platform-registry.localhost:5001/wp-operator'

# Release name used by helm() in the root Tiltfile.
# The ClusterRole and ClusterRoleBinding are named <release>-wp-operator.
RELEASE_NAME = 'wasm-platform'

def wp_operator(namespace='wasm-platform'):
    source_deps = [
        'components/wp-operator/cmd',
        'components/wp-operator/api',
        'components/wp-operator/internal',
        'components/wp-operator/go.mod',
        'components/wp-operator/go.sum',
    ]

    k8s_kind('Application',
             image_json_path = ['{.spec.functions[*].module}', '{.spec[?(@.migrations)].migrations.artifact}'],
             pod_readiness = 'ignore')

    custom_build(
        IMAGE_REF,
        command = (
            'docker build' +
            ' -t $EXPECTED_REF' +
            ' components/wp-operator'
        ),
        deps = source_deps + ['components/wp-operator/Dockerfile'],
    )

    k8s_resource(
        'wp-operator',
        labels = ['platform'],
        port_forwards = ['50051:50051'],
        objects = [
            'wp-operator:ServiceAccount:{}'.format(namespace),
            '{}-wp-operator:ClusterRole'.format(RELEASE_NAME),
            '{}-wp-operator:ClusterRoleBinding'.format(RELEASE_NAME),
        ],
    )

    k8s_resource(
        new_name = 'wp-webhook',
        objects = [
            'wasm-platform-selfsigned:ClusterIssuer',
            'wp-operator-webhook-tls:Certificate:{}'.format(namespace),
            'wasm-platform-application-validator:ValidatingWebhookConfiguration',
        ],
        labels = ['platform'],
        resource_deps = ['cert-manager-ready'],
    )

    local_resource(
        'wp: unit-tests',
        cmd = 'cd components/wp-operator && GOWORK=off go test -mod=readonly -count=1 -timeout=5m ./...',
        deps = source_deps,
        resource_deps = ['ci: record-revision'] if CI_MODE else [],
        labels = ['wp-operator'],
    )

    local_resource(
        'wp: lint',
        cmd = 'cd components/wp-operator && GOWORK=off go vet -mod=readonly ./...',
        deps = source_deps,
        resource_deps = ['ci: record-revision'] if CI_MODE else [],
        labels = ['wp-operator'],
        auto_init = CI_MODE,
        trigger_mode = TRIGGER_MODE_AUTO if CI_MODE else TRIGGER_MODE_MANUAL,
    )

    local_resource(
        'wp: integration-tests',
        cmd = 'cd components/wp-operator && GOWORK=off go test -mod=readonly -tags integration -count=1 -timeout=5m -v ./internal/integration/...',
        deps = source_deps,
        resource_deps = ['wp-operator', 'wp-webhook'] + (['ci: record-revision'] if CI_MODE else []),
        labels = ['wp-operator'],
        auto_init = CI_MODE,
        trigger_mode = TRIGGER_MODE_AUTO if CI_MODE else TRIGGER_MODE_MANUAL,
    )
