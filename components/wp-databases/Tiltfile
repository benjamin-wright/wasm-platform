load('ext://helm_resource', 'helm_resource')
load('../../tilt/namespace.Tiltfile', 'k8s_namespace')

def db_operator(namespace):
    k8s_namespace(namespace)
    helm_resource(
        'db-operator',
        namespace=namespace,
        chart='oci://docker.io/benwright/db-operator-chart:v1.1.7',
        labels=['platform'],
        flags=[
            '--set=mcp.enabled=true',
        ],
    )
    local_resource(
        'db-operator-crds-ready',
        cmd=(
            'kubectl wait --for=condition=Established --timeout=120s' +
            ' crd/natsclusters.db-operator.benjamin-wright.github.com' +
            ' crd/natsaccounts.db-operator.benjamin-wright.github.com &&' +
            ' kubectl rollout status deployment/db-operator -n {} --timeout=120s'.format(namespace)
        ),
        resource_deps=['db-operator'],
        labels=['internal'],
    )


def wp_databases(namespace='wasm-platform'):
    k8s_resource(
        new_name='wp-databases',
        objects=[
            'wasm-platform-nats:NatsCluster:{}'.format(namespace),
            'wasm-platform-nats-execution-host:NatsAccount:{}'.format(namespace),
            'wasm-platform-nats-gateway:NatsAccount:{}'.format(namespace),
        ],
        resource_deps=['db-operator-crds-ready'],
        pod_readiness='ignore',
        labels=['platform'],
    )
