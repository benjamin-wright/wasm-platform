load('ext://helm_resource', 'helm_resource')
load('../../tilt/namespace.Tiltfile', 'k8s_namespace')

def db_operator(namespace):
    k8s_namespace(namespace)
    helm_resource(
        'db-operator',
        namespace=namespace,
        chart='oci://docker.io/benwright/db-operator-chart:v1.1.6',
        labels=['platform'],
        flags=[
            '--set=mcp.enabled=true',
        ],
    )
    local_resource(
        'db-operator-crds-ready',
        cmd='kubectl rollout status deployment/db-operator -n {} --timeout=120s'.format(namespace),
        resource_deps=['db-operator'],
        labels=['internal'],
    )

def wp_databases(namespace):
    # wp-operator now manages all database CR lifecycles. The Tilt resource
    # below tracks the operator-provisioned CRs so their status is visible
    # in the Tilt UI. These objects are created by wp-operator, not by the
    # Helm chart; they will only appear once the first Application is deployed.
    release = 'wasm-platform'
    k8s_resource(
        new_name = 'wp-databases',
        objects = [
            '{}:NatsCluster:{}'.format('wasm-platform-nats', namespace),
            '{}:NatsAccount:{}'.format('wasm-platform-nats-execution-host', namespace),
            '{}:NatsAccount:{}'.format('wasm-platform-nats-gateway', namespace),
            '{}:RedisDatabase:{}'.format('wasm-platform-redis', namespace),
            '{}:RedisCredential:{}'.format('wasm-platform-redis-execution-host', namespace),
        ],
        labels = ['platform'],
        resource_deps = ['db-operator-crds-ready'],
    )
