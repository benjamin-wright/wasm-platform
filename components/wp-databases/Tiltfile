load('ext://helm_resource', 'helm_resource')
load('../../tilt/namespace.Tiltfile', 'k8s_namespace')

def db_operator(namespace):
    k8s_namespace(namespace)
    helm_resource(
        'db-operator',
        namespace=namespace,
        chart='oci://docker.io/benwright/db-operator-chart:v1.1.6',
        labels=['platform'],
        flags=[
            '--set=mcp.enabled=true',
        ],
    )
    local_resource(
        'db-operator-crds-ready',
        cmd='kubectl rollout status deployment/db-operator -n {} --timeout=120s'.format(namespace),
        resource_deps=['db-operator'],
        labels=['internal'],
    )

def wp_databases(namespace):
    # Group all database CRs rendered by the umbrella chart into a single Tilt
    # resource so they are applied only after db-operator is ready.
    release = 'wasm-platform'
    k8s_resource(
        new_name = 'wp-databases',
        objects = [
            '{}:PostgresDatabase:{}'.format(release + '-postgres', namespace),
            '{}:RedisDatabase:{}'.format(release + '-redis', namespace),
            '{}:RedisCredential:{}'.format(release + '-redis-wp-operator', namespace),
            '{}:RedisCredential:{}'.format(release + '-redis-execution-host', namespace),
            '{}:NatsCluster:{}'.format(release + '-nats', namespace),
            '{}:NatsAccount:{}'.format(release + '-nats-wp-operator', namespace),
            '{}:NatsAccount:{}'.format(release + '-nats-execution-host', namespace),
            '{}:NatsAccount:{}'.format(release + '-nats-gateway', namespace),
        ],
        labels = ['platform'],
        resource_deps = ['db-operator-crds-ready'],
    )
